@model List<TodoMVC.Models.Productos>

@{
    ViewData["Title"] = "Mis Productos";
}

<div class="container">
    <div class="card-header">
        <h1> Mis Productos</h1>
        <a href="/Productos/Aniadir" class="btn btn-primary">+ Nuevo producto</a>
    </div>

    @if (Model.Count == 0)
    {
        <p class="empty">Añadir productos!</p>
    }
    else
    {
        <ul class="products-list">
            @foreach (var producto in Model)
            {
                <li class="task-item @(producto.comprado ? "comprado" : "")">
                    
                    <span class="task-title">
                        <span class="nombre">@producto.nombre</span>
                        <span class="cantidad">Cant: @producto.cantidad</span>
                        <span class="estado-badge @(producto.comprado ? "estado-comprado" : "estado-pendiente")">
                            @(producto.comprado ? "✔ Comprado" : "⏳ Pendiente")
                        </span>
                    </span>
                    <span class="task-actions">
                        @if (!producto.comprado)
                        {
                            <a href="/Productos/Comprado/@producto.Id" class="btn btn-success">Marcar como comprado</a>
                        }
                        <a href="/Productos/Eliminar/@producto.Id" class="btn btn-danger"
                           onclick="return confirm('¿Eliminar este producto?')">Eliminar</a>

                        <a href="/Productos/Editar/@producto.Id" class="btn btn-warning">Editar</a>

                        <a href="/Productos/Detalle/@producto.Id" class="btn btn-info">Detalle</a>
                    </span>
                </li>
            }
        </ul>
    }
</div>
